# Copy to .env for local development, or set the same values in your process manager.
HERMES_CLI_PATH=/absolute/path/to/hermes
HERMES_VAULT_PATH=/absolute/path/to/your/ObsidianVault
HERMES_MANAGER_ALLOWED_ORIGINS=https://your-project.vercel.app
HERMES_MANAGER_TOKEN=replace-with-a-long-random-token
HERMES_MANAGER_PORT=4174
